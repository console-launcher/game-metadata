"""The README's Rust, C and Kotlin snippets are the marked lines (readme:begin .. readme:end) of files that scripts/check
compiles (the gamemeta-core `readme` example, examples/c/readme.c, the Kotlin `ReadmeSnippetTest`). This checks the README
still shows exactly those lines, so a snippet cannot drift from code that builds. Exit 1 on a difference."""
import os
import re
import sys
import textwrap

ROOT = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..")
SNIPPETS = [
    ("rust", "crates/gamemeta-core/examples/readme.rs"),
    ("c", "examples/c/readme.c"),
    ("kotlin", "bindings/kotlin/src/test/kotlin/gamemeta/ReadmeSnippetTest.kt"),
]


def region(path):
    lines = open(os.path.join(ROOT, path), encoding="utf-8").read().splitlines()
    begin = next(i for i, l in enumerate(lines) if "readme:begin" in l)
    end = next(i for i, l in enumerate(lines) if "readme:end" in l)
    return textwrap.dedent("\n".join(lines[begin + 1 : end])).strip()


def main():
    readme = open(os.path.join(ROOT, "README.md"), encoding="utf-8").read()
    blocks = {}
    for lang, body in re.findall(r"```(\w+)\n(.*?)```", readme, re.S):
        blocks.setdefault(lang, []).append(body.strip())
    bad = 0
    for lang, path in SNIPPETS:
        want = region(path)
        if want not in blocks.get(lang, []):
            print(f"README's {lang} snippet differs from the marked lines of {path}", file=sys.stderr)
            bad = 1
    return bad


sys.exit(main())
