#!/usr/bin/env python3
# This Source Code Form is subject to the terms of the Mozilla Public
# License, v. 2.0. If a copy of the MPL was not distributed with this
# file, You can obtain one at https://mozilla.org/MPL/2.0/.

"""The third-party license section of NOTICE.md, generated from Cargo.lock and the crates' own license files.
  scripts/third-party-notices           rewrite the section between the markers in NOTICE.md
  scripts/third-party-notices --check   exit 1 if NOTICE.md is stale or a crate that an artifact links has no entry

Artifacts covered: the core library, the C library (ffi), the Android/JVM binding (jni), the CLI and the wasm package, with
every target's dependencies (`cargo tree --target all`). Each crate gets its license expression and copyright lines; each
distinct license text is printed once. Needs the crates in the cargo registry (`cargo fetch --locked`)."""
import hashlib
import json
import os
import re
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
NOTICE = os.path.join(ROOT, "NOTICE.md")
BEGIN = "<!-- BEGIN THIRD-PARTY (generated by scripts/third-party-notices; do not edit) -->"
END = "<!-- END THIRD-PARTY -->"
ARTIFACTS = ["gamemeta-core", "gamemeta-ffi", "gamemeta-jni", "gamemeta-cli", "gamemeta-wasm"]
COPYRIGHT = re.compile(r"^\s*(copyright\b|\(c\)|©)", re.I)
LICENSE_FILE = re.compile(r"^(licen[sc]e|copying|unlicense|notice)", re.I)


MIT = """MIT License

Copyright (c) %s

Permission is hereby granted, free of charge, to any person obtaining a copy of this software and associated documentation files
(the "Software"), to deal in the Software without restriction, including without limitation the rights to use, copy, modify,
merge, publish, distribute, sublicense, and/or sell copies of the Software, and to permit persons to whom the Software is
furnished to do so, subject to the following conditions:

The above copyright notice and this permission notice shall be included in all copies or substantial portions of the Software.

THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF
MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE
FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN
CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
"""


def cargo(*args):
    return subprocess.run(["cargo", *args], cwd=ROOT, check=True, capture_output=True, text=True).stdout


def linked():
    """{(name, version)} of every non-workspace crate the artifacts depend on, for all targets (a superset of what one links)."""
    seen = set()
    for pkg in ARTIFACTS:
        for line in cargo("tree", "--locked", "-e", "normal", "--target", "all", "--prefix", "none", "-p", pkg).splitlines():
            m = re.match(r"^(\S+) v(\S+)", line)
            if m and "(/" not in line:  # path crates carry "(/abs/path)": those are this repository
                seen.add((m.group(1), m.group(2)))
    return seen


def metadata():
    out = json.loads(cargo("metadata", "--locked", "--format-version", "1"))
    return {(p["name"], p["version"]): p for p in out["packages"]}


def license_files(pkg):
    d = os.path.dirname(pkg["manifest_path"])
    names = []
    if pkg.get("license_file"):
        names.append(pkg["license_file"])
    names += sorted(n for n in os.listdir(d) if LICENSE_FILE.match(n) and os.path.isfile(os.path.join(d, n)))
    out, seen = [], set()
    for n in names:
        p = os.path.join(d, n)
        if p not in seen:
            seen.add(p)
            out.append(p)
    return out


def split(text):
    """(copyright lines, template text with those lines removed and whitespace normalised)."""
    notices, rest = [], []
    for line in text.replace("\r\n", "\n").split("\n"):
        if COPYRIGHT.match(line) and "[" not in line:  # "Copyright [yyyy] [name]" is Apache's appendix boilerplate
            notices.append(line.strip())
        else:
            rest.append(line.rstrip())
    return notices, re.sub(r"\n{3,}", "\n\n", "\n".join(rest)).strip() + "\n"


def entries():
    meta, rows = metadata(), []
    for key in sorted(linked()):
        pkg = meta[key]
        rows.append((pkg, license_files(pkg)))
    return rows


def render():
    rows = entries()
    texts = {}  # sha -> (template, [crate labels])
    out = [BEGIN, "", "## Third-party crates and licenses", "",
           "The crates below are compiled into the library, the Android and JVM binding, the command line tool or the wasm package "
           "(the website). Each is used under the license named; the copyright lines and license texts follow, as those licenses "
           "require for binary redistribution. Generated from `Cargo.lock`.", ""]
    for pkg, files in rows:
        label = "%s %s" % (pkg["name"], pkg["version"])
        notices, shas = [], []
        if not files:  # the crate ships no license file: the standard MIT text with its authors, as its license expression allows
            if "MIT" not in (pkg.get("license") or ""):
                raise SystemExit("no license file for %s and no MIT option to fall back on" % label)
            files = [None]
        for f in files:
            if f is None:
                n, tmpl = split(MIT % ", ".join(pkg["authors"]))
            else:
                with open(f, encoding="utf-8", errors="replace") as fh:
                    n, tmpl = split(fh.read())
            notices += [x for x in n if x not in notices]
            sha = hashlib.sha256(tmpl.encode()).hexdigest()[:10]
            texts.setdefault(sha, (tmpl, []))[1].append(label)
            shas.append(sha)
        out.append("### %s" % label)
        out.append("")
        out.append("License: %s. Text: %s." % (pkg.get("license") or "see files", ", ".join("[%s]" % s for s in dict.fromkeys(shas))))
        if notices:
            out.append("")
            out += ["    " + x for x in notices]
        out.append("")
    out += ["## License texts", ""]
    for sha, (tmpl, labels) in sorted(texts.items(), key=lambda kv: kv[1][1][0]):
        out += ["### [%s]" % sha, "", "Used by: %s." % ", ".join(dict.fromkeys(labels)), "", "```text", tmpl.rstrip("\n"), "```", ""]
    out.append(END)
    return "\n".join(out) + "\n"


def current():
    with open(NOTICE, encoding="utf-8") as f:
        return f.read()


def replace(text, section):
    if BEGIN in text:
        head, rest = text.split(BEGIN, 1)
        tail = rest.split(END, 1)[1].lstrip("\n") if END in rest else ""
        return head + section + ("\n" + tail if tail else "")
    return text.rstrip("\n") + "\n\n" + section


def missing(text, rows):
    """Linked crates with no entry heading in NOTICE.md."""
    return ["%s %s" % (p["name"], p["version"]) for p, _ in rows if "### %s %s\n" % (p["name"], p["version"]) not in text]


def main(argv):
    if argv not in ([], ["--check"]):
        print(__doc__, file=sys.stderr)
        return 2
    section = render()
    text = current()
    if argv == ["--check"]:
        gone = missing(text, entries())
        if gone:
            print("NOTICE.md lacks linked crates: %s" % ", ".join(gone))
            print("run scripts/third-party-notices")
            return 1
        if replace(text, section) != text:
            print("NOTICE.md third-party section is stale: run scripts/third-party-notices")
            return 1
        return 0
    with open(NOTICE, "w", encoding="utf-8") as f:
        f.write(replace(text, section))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
