# Regenerates crates/gamemeta-ffi/include/gamemeta.h from the FFI crate (cargo install --locked cbindgen).
set -euo pipefail
cd "$(dirname "$0")/.."
cbindgen --quiet --config crates/gamemeta-ffi/cbindgen.toml --crate gamemeta-ffi --output crates/gamemeta-ffi/include/gamemeta.h crates/gamemeta-ffi
